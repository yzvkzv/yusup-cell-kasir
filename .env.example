# Vercel KV — penyimpanan cloud untuk data kasir.
# Nilai ini terisi OTOMATIS kalau KV store dibuat dari dashboard Vercel
# dan dihubungkan ke project ini (Storage → Create Database → KV).
# Kalau deploy dari folder / repo sendiri, isi manual dari halaman
# Settings → Environment Variables di project Vercel.
# Tanpa kedua variabel ini, aplikasi tetap jalan memakai localStorage
# di perangkat kasir (mode lokal, tanpa sinkron antar perangkat).
KV_REST_API_URL=
KV_REST_API_TOKEN=
